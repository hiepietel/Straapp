# For docker compose only. Copy to .env (which git ignores) and fill in.
# Kubernetes gets the same values from secrets created on the server (see infra/README.md).

# Any strong password; only the API uses it.
POSTGRES_PASSWORD=

# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# At least 32 random bytes, base64. Generate one with:  openssl rand -base64 64 | tr -d '\n'
AUTH_SIGNING_KEY=
